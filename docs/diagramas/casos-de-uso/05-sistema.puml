@startuml CU_05_Sistema
title CiberFamilias - Casos de uso de los actores de sistema
left to right direction
skinparam packageStyle rectangle
actor "Planificador" as T <<sistema>>
actor "Servicio de correo" as M <<sistema>>
actor "Docente" as D
rectangle "CiberFamilias" {
  usecase "CU-26 Calcular métricas\nagregadas" as CU26
  usecase "Detectar alertas\n(inactividad, falencias)" as ALE
  usecase "Enviar resumen semanal" as RES
  usecase "Enviar recordatorio\nde racha" as RAC
}
T --> CU26
T --> RAC
CU26 ..> ALE : <<include>>
RES ..> CU26 : <<extend>>
RES --> M
RAC --> M
RES --> D
@enduml
